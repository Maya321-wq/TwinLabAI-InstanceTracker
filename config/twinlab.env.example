# TwinLab Ops configuration (template).
#
#   cp config/twinlab.env.example config/twinlab.env
#
# config/twinlab.env is ignored by Git. It is READ as KEY=VALUE text, never
# executed as shell code. Do NOT put AWS keys in this file.
#
# Rules: one KEY=VALUE per line, no spaces around "=", no duplicate keys.

# --- Required -------------------------------------------------------------
# The EC2 instance id you verified (the old Makefile.v2.backup contains the one
# you were using; copy it here yourself).
INSTANCE_ID=i-REPLACE_WITH_YOUR_INSTANCE_ID
REGION=us-west-2

# --- Required for start / stop / set-type / clear-claim ---------------------
# Your own team username. This is SELF-DECLARED, not verified: everyone shares
# the same AWS key, so AWS cannot tell you apart. Letters, digits, . _ -
OPERATOR=REPLACE_WITH_YOUR_NAME

# --- AWS credentials profile ------------------------------------------------
# Leave empty to keep using whatever your AWS CLI uses today (the "default"
# profile). After running `make configure`, set this to: twinlab
AWS_PROFILE=

# --- Team coordination ------------------------------------------------------
# git   = claims are pushed to the shared repo before AWS is touched (team-wide,
#         needs a remote and push access to GIT_BRANCH)
# local = claims stay on THIS computer only (no protection from teammates)
COORDINATION=git
GIT_REMOTE=origin
GIT_BRANCH=main

# --- Timing -----------------------------------------------------------------
# Minutes before an unfinished operation's claim is considered stale.
CLAIM_TTL_MINUTES=60
# How long to wait for AWS to reach running/stopped, and how often to check.
WAIT_TIMEOUT_SECONDS=600
POLL_SECONDS=15
